# HKNR website — environment variables
# Copy to .env.local for local development. Never commit real values.
# In production (Render), set these in the service's Environment settings.

# ---------------------------------------------------------------- required
# development | test | preview | production
# In production, sample (synthetic) content is always hidden and the stricter checks below apply.
APP_ENV=development

# PostgreSQL connection string (any provider: Render Postgres, Supabase, Neon, …).
# Local default matches docker-compose.yml.
DATABASE_URL=postgres://hknr:hknr_local_dev@localhost:55433/hknr

# Random secret used to hash visitor IP addresses for rate limiting. Required outside development.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# ---------------------------------------------------------------- site URL & indexing
# Public origin used for canonical URLs, sitemap and links in emails.
# On Render this falls back to RENDER_EXTERNAL_URL automatically; set it once a domain is connected.
SITE_URL=

# Search engines may index the site only when "true". Keep "false" until real content is live.
ALLOW_INDEXING=false

# ---------------------------------------------------------------- photo storage
# local = files on disk under LOCAL_STORAGE_DIR (development only; hosted disks are wiped on deploy)
# s3    = any S3-compatible bucket (Cloudflare R2, Supabase Storage S3, AWS S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# Required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket's objects, e.g. https://pub-xxxx.r2.dev or a CDN domain.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- email (optional)
# New-enquiry notifications via Resend. Without these, enquiries are still saved and shown in admin;
# the notification is recorded as "skipped". The recipient is set in Admin → Settings.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "HKNR Website <website@your-domain>"
EMAIL_FROM=
